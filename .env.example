# PayPal sandbox app (developer.paypal.com -> Apps & Credentials, Sandbox). Use a US sandbox Business account.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Free Google AI Studio key (aistudio.google.com)
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash
# Free Groq key (console.groq.com/keys) - primary LLM, ~1000 req/day per model
GROQ_API_KEY=
# Optional explicit order, e.g. groq:openai/gpt-oss-120b,google:gemini-3.5-flash
LLM_MODELS=
# Kernel cloud browser (optional; BROWSER_PROVIDER=kernel only works against a public URL)
KERNEL_API_KEY=
BROWSER_PROVIDER=local
PUBLIC_BASE_URL=http://localhost:3000
APPROVAL_TIMEOUT_MS=900000
DB_PATH=./lintel.db
# Sandbox test buyer (US or any country) for approving payments
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=

# Accounts with these emails are Lintel admins (comma-separated)
ADMIN_EMAILS=

# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, Web application)
# Authorized redirect URI: <PUBLIC_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Connect with Shopify (Shopify Partners > Apps > Create app). Allowed redirect URL: <PUBLIC_BASE_URL>/api/auth/shopify/callback
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Encrypts stored third-party tokens. Any long random string; Render generates one.
LINTEL_SECRET=

# Development only: local test shops Lintel may reach (ignored in production), e.g. the demo-shop on port 4000
DEV_STORE_HOSTS=localhost:4000
