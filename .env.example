# PayPal sandbox app (developer.paypal.com -> Apps & Credentials, Sandbox). Use a US sandbox Business account.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Free Google AI Studio key (aistudio.google.com)
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash
# Kernel cloud browser (optional; BROWSER_PROVIDER=kernel only works against a public URL)
KERNEL_API_KEY=
BROWSER_PROVIDER=local
PUBLIC_BASE_URL=http://localhost:3000
APPROVAL_TIMEOUT_MS=300000
DB_PATH=./lintel.db
# Sandbox test buyer (US or any country) for approving payments
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=
